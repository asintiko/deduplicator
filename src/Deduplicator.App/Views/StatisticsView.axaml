<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Deduplicator.App.Localization"
             x:Class="Deduplicator.App.Views.StatisticsView">

    <ScrollViewer>
        <StackPanel Margin="28,24" Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="h1" Text="{x:Static loc:Strings.StatisticsTitle}" VerticalAlignment="Center"/>
                    <TextBlock Classes="muted" Text="Сколько файлов запомнено, сколько дублей найдено и сколько места можно освободить." Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <!-- #18: данные грузятся при входе; кнопка позволяет обновить, не уходя с экрана -->
                <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Center" Command="{Binding LoadCommand}"
                        ToolTip.Tip="Пересчитать итоги по текущему архиву и найденным дублям">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconRefresh}"/>
                        <TextBlock Text="{x:Static loc:Strings.Refresh}"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Карточки сводки -->
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" >
                <Border Classes="card" Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                    <StackPanel Spacing="6">
                        <PathIcon Data="{StaticResource IconLayers}" HorizontalAlignment="Left"
                                  Foreground="{DynamicResource AccentBrush}" Width="22" Height="22"/>
                        <TextBlock Classes="caption" Text="{x:Static loc:Strings.StatExactGroups}"/>
                        <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding ExactGroupsText}"/>
                    </StackPanel>
                </Border>
                <Border Classes="card" Grid.Row="0" Grid.Column="1" Margin="8,0,8,8">
                    <StackPanel Spacing="6">
                        <PathIcon Data="{StaticResource IconImage}" HorizontalAlignment="Left"
                                  Foreground="{DynamicResource AccentBrush}" Width="22" Height="22"/>
                        <TextBlock Classes="caption" Text="{x:Static loc:Strings.StatSimilarImages}"/>
                        <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding SimilarImagesText}"/>
                    </StackPanel>
                </Border>
                <Border Classes="card" Grid.Row="0" Grid.Column="2" Margin="8,0,0,8">
                    <StackPanel Spacing="6">
                        <PathIcon Data="{StaticResource IconMusic}" HorizontalAlignment="Left"
                                  Foreground="{DynamicResource AccentBrush}" Width="22" Height="22"/>
                        <TextBlock Classes="caption" Text="{x:Static loc:Strings.StatSimilarAudio}"/>
                        <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding SimilarAudioText}"/>
                    </StackPanel>
                </Border>

                <Border Classes="card" Grid.Row="1" Grid.Column="0" Margin="0,8,8,0">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="caption" Text="{x:Static loc:Strings.StatTotalReclaimable}"/>
                        <TextBlock FontSize="26" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SuccessBrush}" Text="{Binding TotalReclaimableText}"/>
                    </StackPanel>
                </Border>
                <Border Classes="card" Grid.Row="1" Grid.Column="1" Margin="8,8,8,0">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="caption" Text="{x:Static loc:Strings.StatDuplicateFiles}"/>
                        <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding DuplicateFilesText}"/>
                    </StackPanel>
                </Border>
                <Border Classes="card" Grid.Row="1" Grid.Column="2" Margin="8,8,0,0">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="caption" Text="{x:Static loc:Strings.StatIndexed}"/>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding IndexedText}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Разбивка по категориям -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <TextBlock Classes="h2" Text="{x:Static loc:Strings.StatByCategory}"/>
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="120,*,Auto" Margin="0,5">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Height="18" CornerRadius="9" Width="{Binding BarWidth}"
                                            HorizontalAlignment="Left" Background="{Binding Color}"/>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="caption">
                                        <Run Text="{Binding BytesText}"/><Run Text="  ·  "/><Run Text="{Binding CountText}"/>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
