<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Deduplicator.App.Localization"
        x:Class="Deduplicator.App.Views.SplashWindow"
        Width="480" Height="340"
        CanResize="False" ShowInTaskbar="False"
        SystemDecorations="None" WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="Transparent" Background="Transparent"
        Opacity="0" Icon="/Assets/app-icon-256.png">

    <Window.Styles>
        <Style Selector="Window">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.4" />
                </Transitions>
            </Setter>
        </Style>
        <!-- Мягкая пульсация логотипа -->
        <Style Selector="Image.pulse">
            <Style.Animations>
                <Animation Duration="0:0:1.6" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.78" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Border CornerRadius="24" Background="{DynamicResource SurfaceBackground}"
            BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
            BoxShadow="0 20 60 0 #50000000" Margin="16">
        <Grid RowDefinitions="*,Auto">
            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="18">
                <Image Classes="pulse" Source="/Assets/app-icon-256.png" Width="104" Height="104"
                       HorizontalAlignment="Center" />
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="Deduplicator" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Classes="muted" Text="{x:Static loc:Strings.AppTagline}" HorizontalAlignment="Center" />
                </StackPanel>
                <ProgressBar IsIndeterminate="True" Width="300" />
                <TextBlock x:Name="StatusText" Classes="caption" HorizontalAlignment="Center"
                           Text="{x:Static loc:Strings.SplashStarting}" />
            </StackPanel>
            <TextBlock Grid.Row="1" Classes="caption" HorizontalAlignment="Center" Margin="0,0,0,16"
                       Text="Версия 1.0 · полностью офлайн" />
        </Grid>
    </Border>
</Window>
