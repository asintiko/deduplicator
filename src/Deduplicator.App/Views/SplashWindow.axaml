<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Deduplicator.App.Localization"
        xmlns:controls="clr-namespace:Deduplicator.App.Controls"
        x:Class="Deduplicator.App.Views.SplashWindow"
        Width="480" Height="400"
        CanResize="False" ShowInTaskbar="False"
        SystemDecorations="None" WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="Transparent" Background="Transparent"
        Opacity="0" Icon="/Assets/app-icon-256.png">

    <Window.Styles>
        <Style Selector="Window">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.4" />
                </Transitions>
            </Setter>
        </Style>
    </Window.Styles>

    <!-- Ночь-6: заставка на фирменном анимированном лого (AnimatedLogo 160, «объёмное»
         вращение) + строка статуса инициализации (обновляет App через SetStatus)
         + тонкий градиентный неопределённый прогресс снизу. -->
    <Border CornerRadius="24" Background="{DynamicResource AppBackground}"
            BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1"
            BoxShadow="0 20 60 0 #50000000" Margin="16">
        <Grid RowDefinitions="*,Auto">
            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14">
                <controls:AnimatedLogo Size="160" HorizontalAlignment="Center" />
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Classes="h1" FontSize="30" Text="Deduplicator" HorizontalAlignment="Center" />
                    <TextBlock Classes="muted" Text="{x:Static loc:Strings.AppTagline}" HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="1" Spacing="10" Margin="36,0,36,18">
                <TextBlock x:Name="StatusText" Classes="caption" HorizontalAlignment="Center"
                           Text="{x:Static loc:Strings.SplashStarting}" />
                <ProgressBar IsIndeterminate="True" MinHeight="4" Height="4" CornerRadius="2" />
                <TextBlock Classes="caption" HorizontalAlignment="Center" Text="Версия 1.0 · полностью офлайн" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
