<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Deduplicator.App.Localization"
             x:Class="Deduplicator.App.Views.VolumesView">

    <Grid RowDefinitions="Auto,*" Margin="28,24">
        <!-- Заголовок -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Classes="h1" Text="{x:Static loc:Strings.VolumesTitle}"/>
                <TextBlock Classes="muted" Text="{x:Static loc:Strings.VolumesSubtitle}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Top"
                    Command="{Binding RefreshCommand}"
                    ToolTip.Tip="Обновить список подключённых и сохранённых дисков">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IconRefresh}"/>
                    <TextBlock Text="{x:Static loc:Strings.Refresh}"/>
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">
                <!-- Сводка -->
                <Border Classes="card">
                    <Grid ColumnDefinitions="*,*,*">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Classes="caption" Text="{x:Static loc:Strings.TotalVolumes}"/>
                            <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding TotalVolumes}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Classes="caption" Text="{x:Static loc:Strings.TotalFiles}"/>
                            <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding TotalFilesText}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Classes="caption" Text="{x:Static loc:Strings.VolumeCapacity}"/>
                            <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding TotalSizeText}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Список носителей -->
                <ItemsControl x:Name="OnboardingVolumeList" ItemsSource="{Binding Volumes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="card" Margin="0,0,0,12">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12"
                                            Background="{DynamicResource AccentSoft}" VerticalAlignment="Top">
                                        <PathIcon Data="{StaticResource IconHdd}" Width="26" Height="26"
                                                  Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="16,0" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold"/>
                                            <Border Classes="badge" VerticalAlignment="Center"
                                                    Background="{DynamicResource SurfaceAlt}"
                                                    BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1">
                                                <TextBlock Text="{Binding StatusText}"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Classes="caption">
                                            <Run Text="{x:Static loc:Strings.VolumeSerial}"/><Run Text=": "/><Run Text="{Binding Serial}"/>
                                            <Run Text="   ·   "/><Run Text="{x:Static loc:Strings.VolumeFs}"/><Run Text=": "/><Run Text="{Binding Fs}"/>
                                            <Run Text="   ·   "/><Run Text="{Binding CapacityText}"/>
                                        </TextBlock>
                                        <TextBlock Classes="caption" Text="{Binding SummaryLine}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Classes="ghost" Command="{Binding $parent[ItemsControl].DataContext.RemoveCommand}"
                                                CommandParameter="{Binding}" ToolTip.Tip="{x:Static loc:Strings.RemoveFromCatalog}">
                                            <PathIcon Data="{StaticResource IconClose}"/>
                                        </Button>
                                        <Button Classes="ghost" Command="{Binding $parent[ItemsControl].DataContext.ExploreCommand}"
                                                CommandParameter="{Binding}" ToolTip.Tip="{x:Static loc:Strings.NavExplorer}">
                                            <PathIcon Data="{StaticResource IconFolder}"/>
                                        </Button>
                                        <Button Classes="ghost" Command="{Binding $parent[ItemsControl].DataContext.OpenInExplorerCommand}"
                                                CommandParameter="{Binding}" IsEnabled="{Binding IsConnected}"
                                                ToolTip.Tip="{x:Static loc:Strings.OpenInExplorer}">
                                            <PathIcon Data="{StaticResource IconChevronRight}"/>
                                        </Button>
                                        <Button Classes="primary" Command="{Binding $parent[ItemsControl].DataContext.ScanCommand}"
                                                CommandParameter="{Binding}" IsEnabled="{Binding IsConnected}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <PathIcon Data="{StaticResource IconSearch}" Foreground="White"/>
                                                <TextBlock Text="{x:Static loc:Strings.ScanThisVolume}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Подтверждение удаления носителя из каталога -->
        <Border Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding ShowRemoveConfirm}" Background="{DynamicResource OverlayDim}"
                Margin="-28,-24">
            <Border Classes="card" Width="430" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Classes="h2" Text="{x:Static loc:Strings.RemoveFromCatalog}"/>
                    <TextBlock Text="{x:Static loc:Strings.ConfirmRemoveVolume}" TextWrapping="Wrap" Classes="muted"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <Button Command="{Binding CancelRemoveCommand}"><TextBlock Text="{x:Static loc:Strings.Cancel}"/></Button>
                        <Button Classes="danger" Command="{Binding ConfirmRemoveCommand}"><TextBlock Text="{x:Static loc:Strings.Delete}"/></Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
