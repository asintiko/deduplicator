<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Deduplicator.App.Localization"
             x:Class="Deduplicator.App.Views.ConsolidationView">

    <Grid RowDefinitions="Auto,*" Margin="28,24">
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Classes="h1" Text="{x:Static loc:Strings.ConsolidationTitle}"/>
            <TextBlock Classes="muted" Text="{x:Static loc:Strings.ConsolidationSubtitle}" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" MaxWidth="1000" HorizontalAlignment="Left">

                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="h2" Text="{x:Static loc:Strings.ConsolidationSources}"/>
                        <ItemsControl ItemsSource="{Binding Sources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,3">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <PathIcon Data="{StaticResource IconHdd}" Width="16" Height="16"/>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Medium"/>
                                            <TextBlock Text="{Binding StatusText}" Classes="caption" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding IndexedText}" Classes="caption" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Static loc:Strings.ConsolidationTarget}" Classes="muted"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding TargetPath, Mode=TwoWay}" Watermark="D:\Архив"/>
                                <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding BrowseCommand}"
                                        ToolTip.Tip="Выбрать папку, куда будет собран чистый архив">
                                    <TextBlock Text="{x:Static loc:Strings.Browse}"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="{x:Static loc:Strings.ConsolidationRule}" Classes="muted"/>
                                <ComboBox MinWidth="240" ItemsSource="{Binding Rules}"
                                          SelectedItem="{Binding SelectedRule, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <CheckBox Grid.Column="1" VerticalAlignment="Bottom" IsChecked="{Binding PreserveStructure, Mode=TwoWay}"
                                      ToolTip.Tip="Оставить привычные папки внутри нового архива"
                                      Content="{x:Static loc:Strings.PreserveStructure}"/>
                        </Grid>

                        <!-- 3.5: схлопывание почти одинаковых фото (по умолчанию выключено). -->
                        <CheckBox IsChecked="{Binding CollapseSimilarPhotos, Mode=TwoWay}"
                                  ToolTip.Tip="Из нескольких почти неразличимых кадров в архив поедет один — самый чёткий. Исходные файлы на дисках не удаляются."
                                  Content="{x:Static loc:Strings.CollapseSimilarPhotos}"/>

                        <Button Classes="primary" HorizontalAlignment="Left" Command="{Binding BuildPlanCommand}"
                                ToolTip.Tip="Сначала посчитать, что будет скопировано. Файлы пока не меняются.">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconLayers}" Foreground="White"/>
                                <TextBlock Text="{x:Static loc:Strings.BuildPlan}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- План -->
                <Border Classes="card" IsVisible="{Binding HasPlan}">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,*,*,*,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="caption" Text="{x:Static loc:Strings.PlanUnique}"/>
                                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding UniqueText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="caption" Text="{x:Static loc:Strings.PlanSkipped}"/>
                                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding SkippedText}"/>
                            </StackPanel>
                            <!-- 3.5: сколько похожих фото схлопнуто (не поедут, останутся на источниках). -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="caption" Text="{x:Static loc:Strings.PlanCollapsed}"/>
                                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding CollapsedText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Classes="caption" Text="{x:Static loc:Strings.PlanBytesCopy}"/>
                                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding BytesCopyText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Classes="caption" Text="{x:Static loc:Strings.PlanBytesSaved}"/>
                                <TextBlock FontSize="22" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessBrush}" Text="{Binding BytesSavedText}"/>
                            </StackPanel>
                        </Grid>

                        <Border BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" CornerRadius="8" MaxHeight="280">
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding Preview}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,*,*,90" Margin="10,5">
                                                <Border Classes="badge" Grid.Column="0" VerticalAlignment="Center"
                                                        Margin="0,0,10,0" Background="{DynamicResource SurfaceAlt}"
                                                        BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1">
                                                    <TextBlock Text="{Binding ActionText}"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Source}" Margin="0,0,10,0" Classes="caption" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding SizeText}" Classes="caption" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Classes="primary" Command="{Binding ExecuteCommand}" IsEnabled="{Binding !IsExecuting}"
                                    ToolTip.Tip="Начать копирование по построенному плану. Исходные диски не изменяются.">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource IconArchive}" Foreground="White"/>
                                    <TextBlock Text="{x:Static loc:Strings.ExecutePlan}"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="danger" Command="{Binding CancelExecuteCommand}" IsVisible="{Binding IsExecuting}"
                                    ToolTip.Tip="Остановить копирование">
                                <TextBlock Text="{x:Static loc:Strings.Cancel}"/>
                            </Button>
                        </StackPanel>

                        <StackPanel Spacing="6" IsVisible="{Binding IsExecuting}">
                            <ProgressBar Value="{Binding ExecProgress}" Maximum="100"/>
                            <TextBlock Text="{Binding ExecCurrent}" Classes="caption" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Сообщение/итог: вынесено из блока плана, чтобы валидация «Построить план»
                     (например, не выбран источник или цель) была видна даже без построенного плана. -->
                <Border IsVisible="{Binding ReportText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        CornerRadius="8" Padding="12" Background="{DynamicResource AccentSoft}">
                    <TextBlock Text="{Binding ReportText}" TextWrapping="Wrap"
                               Foreground="{DynamicResource AccentBrush}"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
