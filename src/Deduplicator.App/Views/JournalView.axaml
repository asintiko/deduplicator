<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Deduplicator.App.Localization"
             x:Class="Deduplicator.App.Views.JournalView">

    <Grid RowDefinitions="Auto,*" Margin="28,24">
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Classes="h1" Text="{x:Static loc:Strings.JournalTitle}"/>
            <TextBlock Classes="muted" Text="{x:Static loc:Strings.JournalHint}" Margin="0,4,0,0"/>
            <!-- #24: причина неудачного восстановления больше не молчит -->
            <Border IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Margin="0,10,0,0" CornerRadius="8" Padding="12,8" Background="{DynamicResource DangerBrush}">
                <TextBlock Text="{Binding Status}" Foreground="White" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Classes="card" Padding="6">
            <Panel>
                <!-- Ночь-4: пустое состояние — иконка + заголовок из VM + подсказка -->
                <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsVisible="{Binding Empty, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <PathIcon Data="{StaticResource IconHistory}" Width="48" Height="48"
                              Foreground="{DynamicResource TextTertiary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Empty}" FontSize="15" FontWeight="Medium"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="420"/>
                    <TextBlock Classes="muted" Text="Когда вы удалите или переименуете файлы, операции появятся здесь — их можно будет отменить."
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="380"/>
                </StackPanel>
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="row" Margin="8,2" Padding="12,8">
                                    <Grid ColumnDefinitions="120,*,120,120,Auto">
                                        <Border Classes="badge" Grid.Column="0" VerticalAlignment="Center"
                                                Margin="0,0,12,0" HorizontalAlignment="Left"
                                                Background="{DynamicResource SurfaceAlt}"
                                                BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1">
                                            <TextBlock Text="{Binding OpText}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding FileName}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SrcPath}" Classes="caption mono" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" Classes="caption" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="3" Text="{Binding WhenText}" Classes="caption" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Button Grid.Column="4" Classes="ghost" Command="{Binding $parent[ItemsControl].DataContext.RestoreCommand}"
                                                CommandParameter="{Binding}" IsEnabled="{Binding CanRestore}" VerticalAlignment="Center"
                                                ToolTip.Tip="Попробовать вернуть файл на прежнее место">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <PathIcon Data="{StaticResource IconRestore}" Width="16" Height="16"/>
                                                <TextBlock Text="{x:Static loc:Strings.Restore}" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Panel>
        </Border>
    </Grid>
</UserControl>
