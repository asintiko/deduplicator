<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Deduplicator.App.Localization"
             x:Class="Deduplicator.App.Views.ExplorerView">

    <UserControl.Styles>
        <!-- Кнопки переключения вида: активная подсвечивается акцентом. -->
        <Style Selector="Button.viewswitch">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.viewswitch.active">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
        </Style>
        <Style Selector="Button.viewswitch.active PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <!-- Хлебные крошки. -->
        <Style Selector="Button.crumb">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <!-- Заголовки колонок списка (сортировка кликом). -->
        <Style Selector="Button.colhdr">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <!-- Плитки вида «значки». -->
        <Style Selector="ListBox.tiles ListBoxItem">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <!-- Строки вида «список». -->
        <Style Selector="ListBox.rows ListBoxItem">
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <!-- Строки колонок вида «столбцы». -->
        <Style Selector="ListBox.millercol ListBoxItem">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <Grid RowDefinitions="Auto,Auto,*" Margin="28,24">
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Classes="h1" Text="{x:Static loc:Strings.ExplorerTitle}"/>
                <TextBlock Classes="muted" Text="{x:Static loc:Strings.ExplorerHint}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,14">
                <TextBlock Text="{x:Static loc:Strings.SelectVolume}" VerticalAlignment="Center" Classes="muted"/>
                <ComboBox MinWidth="280" ItemsSource="{Binding Volumes}"
                          IsEnabled="{Binding !IsTransferring}"
                          ToolTip.Tip="Выберите подключённый диск или сохранённый список отключённого диска"
                          SelectedItem="{Binding SelectedVolume, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconHdd}" Width="16" Height="16"/>
                                <TextBlock Text="{Binding DisplayName}"/>
                                <TextBlock Text="{Binding StatusText}" Classes="caption" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ProgressBar IsIndeterminate="True" Width="120" IsVisible="{Binding IsBusy}" VerticalAlignment="Center"/>
                <Border CornerRadius="6" Padding="8,3" VerticalAlignment="Center" Background="{DynamicResource AccentSoft}"
                        IsVisible="{Binding SourceHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding SourceHint}" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                </Border>
            </StackPanel>

            <Grid Grid.Row="2" ColumnDefinitions="300,14,*">
                <!-- ===== Слева: дерево навигации (как раньше) ===== -->
                <Border Grid.Column="0" Classes="card" Padding="6">
                    <Panel>
                        <TextBlock Text="{Binding Status}" Classes="muted" Margin="14" TextWrapping="Wrap"
                                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <TreeView ItemsSource="{Binding Root}" Background="Transparent"
                                  DoubleTapped="OnNodeDoubleTapped"
                                  SelectionChanged="OnTreeSelectionChanged">
                            <TreeView.Styles>
                                <!-- Ленивая подгрузка папок при раскрытии. -->
                                <Style Selector="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                </Style>
                            </TreeView.Styles>
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Height="26">
                                        <PathIcon Data="{Binding Icon}" Width="15" Height="15"
                                                  Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Panel>
                </Border>

                <!-- ===== Справа: содержимое папки в трёх видах ===== -->
                <Border Grid.Column="2" Classes="card" Padding="10">
                    <Grid RowDefinitions="Auto,Auto,Auto,*">

                        <!-- Крошки + переключатель видов -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="4,0,4,6">
                            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                                <ItemsControl ItemsSource="{Binding Crumbs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Classes="crumb" Content="{Binding Title}"
                                                        Command="{Binding $parent[UserControl].DataContext.NavigateToCrumbCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <PathIcon Data="{StaticResource IconChevronRight}" Width="9" Height="9"
                                                          VerticalAlignment="Center" Margin="1,0"
                                                          Foreground="{DynamicResource TextSecondary}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <ProgressBar IsIndeterminate="True" Width="60" Margin="0,0,10,0"
                                             IsVisible="{Binding IsRightBusy}" VerticalAlignment="Center"/>
                                <Button Classes="viewswitch" Classes.active="{Binding IsIconsMode}"
                                        Command="{Binding SetViewModeCommand}" CommandParameter="icons"
                                        ToolTip.Tip="{x:Static loc:Strings.ExplorerViewIcons}">
                                    <PathIcon Data="{StaticResource IconGrid}" Width="15" Height="15"/>
                                </Button>
                                <Button Classes="viewswitch" Classes.active="{Binding IsListMode}"
                                        Command="{Binding SetViewModeCommand}" CommandParameter="list"
                                        ToolTip.Tip="{x:Static loc:Strings.ExplorerViewList}">
                                    <PathIcon Data="{StaticResource IconList}" Width="15" Height="15"/>
                                </Button>
                                <Button Classes="viewswitch" Classes.active="{Binding IsColumnsMode}"
                                        Command="{Binding SetViewModeCommand}" CommandParameter="columns"
                                        ToolTip.Tip="{x:Static loc:Strings.ExplorerViewColumns}">
                                    <PathIcon Data="{StaticResource IconPanels}" Width="15" Height="15"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Операции с выделением -->
                        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" Margin="4,0,4,6">
                            <!-- Обёртка нужна, чтобы подсказка показывалась и над выключенными кнопками. -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                        ToolTip.Tip="{Binding OperationsHint}">
                                <Button Classes="ghost" Command="{Binding CopySelectedCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource IconCopy}" Width="14" Height="14"/>
                                        <TextBlock Text="{x:Static loc:Strings.ExplorerCopyTo}"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="ghost" Command="{Binding MoveSelectedCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource IconMove}" Width="14" Height="14"/>
                                        <TextBlock Text="{x:Static loc:Strings.ExplorerMoveTo}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding SelectionText}" Classes="caption"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Баннеры: итог, ошибки, подсказка про проверку -->
                        <StackPanel Grid.Row="2" Spacing="6" Margin="4,0,4,6">
                            <Border CornerRadius="8" Padding="10,7" Background="{DynamicResource AccentSoft}"
                                    IsVisible="{Binding SuccessText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding SuccessText}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                            <Border CornerRadius="8" Padding="10,7" Background="#26FF453A"
                                    IsVisible="{Binding OperationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding OperationError}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource DangerBrush}"/>
                            </Border>
                            <Border CornerRadius="8" Padding="10,7" Background="#26FF9F0A"
                                    IsVisible="{Binding ShowRescanHint}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource IconWarning}" Width="14" Height="14"
                                              Foreground="{DynamicResource WarningBrush}"/>
                                    <TextBlock Text="{x:Static loc:Strings.ExplorerRescanHint}" FontSize="12"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Содержимое -->
                        <Panel Grid.Row="3">
                            <TextBlock Text="{Binding RightStatus}" Classes="muted" Margin="14"
                                       IsVisible="{Binding RightStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                            <!-- Вид «крупные значки» -->
                            <ListBox x:Name="IconsList" IsVisible="{Binding IsIconsMode}" Classes="tiles"
                                     ItemsSource="{Binding Entries}" SelectionMode="Multiple"
                                     SelectionChanged="OnRightSelectionChanged"
                                     DoubleTapped="OnEntryDoubleTapped" Background="Transparent">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="112" Spacing="6" Margin="2,8">
                                            <PathIcon Data="{Binding Icon}" Width="44" Height="44"
                                                      Foreground="{DynamicResource TextSecondary}"/>
                                            <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap"
                                                       MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="12"/>
                                            <TextBlock Text="{Binding SizeText}" Classes="caption" TextAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Вид «список» -->
                            <Grid IsVisible="{Binding IsListMode}" RowDefinitions="Auto,*">
                                <Grid Grid.Row="0" ColumnDefinitions="30,*,110,110,150" Margin="10,0,10,4">
                                    <Button Grid.Column="1" Classes="colhdr" Content="{Binding NameHeader}"
                                            Command="{Binding SortByCommand}" CommandParameter="name"/>
                                    <TextBlock Grid.Column="2" Text="{x:Static loc:Strings.ColumnCategory}"
                                               Classes="caption" VerticalAlignment="Center"/>
                                    <Button Grid.Column="3" Classes="colhdr" Content="{Binding SizeHeader}"
                                            Command="{Binding SortByCommand}" CommandParameter="size"/>
                                    <Button Grid.Column="4" Classes="colhdr" Content="{Binding DateHeader}"
                                            Command="{Binding SortByCommand}" CommandParameter="date"/>
                                </Grid>
                                <ListBox x:Name="RowsList" Grid.Row="1" Classes="rows"
                                         ItemsSource="{Binding Entries}" SelectionMode="Multiple"
                                         SelectionChanged="OnRightSelectionChanged"
                                         DoubleTapped="OnEntryDoubleTapped" Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="30,*,110,110,150" Height="26">
                                                <PathIcon Data="{Binding Icon}" Width="15" Height="15"
                                                          Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Left"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding CategoryText}" Classes="caption"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding SizeText}" Classes="caption"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding ModifiedText}" Classes="caption"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>

                            <!-- Вид «столбцы» (Miller) -->
                            <ScrollViewer x:Name="ColumnsScroll" IsVisible="{Binding IsColumnsMode}"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal">
                                    <ItemsControl ItemsSource="{Binding Columns}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="230" BorderBrush="{DynamicResource SurfaceBorder}"
                                                        BorderThickness="0,0,1,0" Padding="0,0,4,0">
                                                    <ListBox Classes="millercol" ItemsSource="{Binding Items}"
                                                             SelectedItem="{Binding Selected, Mode=TwoWay}"
                                                             DoubleTapped="OnEntryDoubleTapped" Background="Transparent">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid ColumnDefinitions="Auto,*,Auto" Height="24">
                                                                    <PathIcon Data="{Binding Icon}" Width="14" Height="14"
                                                                              Foreground="{DynamicResource TextSecondary}"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="6,0"
                                                                               TextTrimming="CharacterEllipsis" FontSize="13"
                                                                               VerticalAlignment="Center"/>
                                                                    <PathIcon Grid.Column="2" Data="{StaticResource IconChevronRight}"
                                                                              Width="9" Height="9" IsVisible="{Binding IsFolder}"
                                                                              Foreground="{DynamicResource TextSecondary}"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Мини-карточка сведений о файле -->
                                    <Border Width="250" Padding="16" VerticalAlignment="Top"
                                            IsVisible="{Binding PreviewFile, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <StackPanel Spacing="8">
                                            <PathIcon Data="{Binding PreviewFile.Icon}" Width="44" Height="44"
                                                      Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding PreviewFile.Name}" TextWrapping="Wrap"
                                                       TextAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding PreviewFile.CategoryText}" Classes="caption"
                                                       TextAlignment="Center"/>
                                            <StackPanel Spacing="2" Margin="0,6,0,0">
                                                <TextBlock Classes="caption">
                                                    <Run Text="{x:Static loc:Strings.ColumnSize}"/><Run Text=": "/><Run Text="{Binding PreviewFile.SizeText}"/>
                                                </TextBlock>
                                                <TextBlock Classes="caption">
                                                    <Run Text="{x:Static loc:Strings.ColumnModified}"/><Run Text=": "/><Run Text="{Binding PreviewFile.ModifiedText}"/>
                                                </TextBlock>
                                                <TextBlock Classes="caption">
                                                    <Run Text="{x:Static loc:Strings.ColumnCreated}"/><Run Text=": "/><Run Text="{Binding PreviewFile.CreatedText}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Classes="ghost" HorizontalAlignment="Center" Margin="0,6,0,0"
                                                    Command="{Binding OpenPreviewCommand}"
                                                    IsVisible="{Binding PreviewFile.AbsolutePath, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <TextBlock Text="{x:Static loc:Strings.ExplorerOpenFile}"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Panel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== Подтверждение операции ===== -->
        <Border IsVisible="{Binding ShowTransferConfirm}" Background="#80000000">
            <Border Classes="card" Width="560" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel Spacing="14">
                    <TextBlock Classes="h2" Text="{Binding TransferConfirmTitle}"/>
                    <TextBlock Text="{Binding TransferConfirmText}" TextWrapping="Wrap"/>
                    <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="6" Padding="10" MaxHeight="160">
                        <ScrollViewer>
                            <TextBlock Text="{Binding TransferItemsPreview}" FontSize="12" Classes="muted"/>
                        </ScrollViewer>
                    </Border>
                    <Border IsVisible="{Binding TransferIsMove}" Background="#26FF9F0A" CornerRadius="8" Padding="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource IconWarning}" Width="18" Height="18"
                                      Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Top"/>
                            <TextBlock Text="{x:Static loc:Strings.ExplorerMoveWarning}" TextWrapping="Wrap" MaxWidth="430"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <Button Command="{Binding CancelTransferDialogCommand}" Content="{x:Static loc:Strings.Cancel}"/>
                        <Button Classes="primary" Command="{Binding ConfirmTransferCommand}"
                                Content="{Binding TransferConfirmAction}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ===== Прогресс операции ===== -->
        <Border IsVisible="{Binding IsTransferring}" Background="#80000000">
            <Border Classes="card" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel Spacing="14">
                    <TextBlock Classes="h2" Text="{Binding TransferConfirmTitle}"/>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding TransferPercent}"/>
                    <TextBlock Text="{Binding TransferStatus}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CancelTransferCommand}" IsEnabled="{Binding !CancelRequested}"
                                Content="{x:Static loc:Strings.Cancel}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</UserControl>
