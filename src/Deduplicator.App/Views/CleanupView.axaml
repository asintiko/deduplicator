<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Deduplicator.App.Localization"
             x:Class="Deduplicator.App.Views.CleanupView">

    <Grid RowDefinitions="Auto,Auto,*" Margin="28,24">
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Classes="h1" Text="{x:Static loc:Strings.CleanupTitle}"/>
            <TextBlock Classes="muted" Text="{x:Static loc:Strings.CleanupSubtitle}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border x:Name="OnboardingCleanupOptions" Grid.Row="1" Classes="card" Margin="0,0,0,14">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Classes="h2" Text="{x:Static loc:Strings.ScanSelectVolumes}"/>
                        <ItemsControl ItemsSource="{Binding Roots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <PathIcon Data="{StaticResource IconHdd}" Width="15" Height="15"/>
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Classes="h2" Text="{x:Static loc:Strings.CleanupWhat}"/>
                        <CheckBox IsChecked="{Binding EmptyFolders, Mode=TwoWay}" Content="{x:Static loc:Strings.CleanupEmptyFolders}"
                                  ToolTip.Tip="Папки без файлов внутри"/>
                        <CheckBox IsChecked="{Binding ZeroByte, Mode=TwoWay}" Content="{x:Static loc:Strings.CleanupZeroByte}"
                                  ToolTip.Tip="Пустые файлы, которые ничего не весят"/>
                        <CheckBox IsChecked="{Binding Temp, Mode=TwoWay}" Content="{x:Static loc:Strings.CleanupTemp}"
                                  ToolTip.Tip="Временные файлы программ"/>
                        <CheckBox IsChecked="{Binding Broken, Mode=TwoWay}" Content="{x:Static loc:Strings.CleanupBroken}"
                                  ToolTip.Tip="Ярлыки, которые ведут в никуда"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <CheckBox IsChecked="{Binding Large, Mode=TwoWay}" Content="{x:Static loc:Strings.CleanupLarge}" VerticalAlignment="Center"
                                      ToolTip.Tip="Показать большие файлы для ручной проверки"/>
                            <NumericUpDown Width="130" Minimum="1" Maximum="100000" Increment="100"
                                           Value="{Binding LargeThresholdMb, Mode=TwoWay}" IsEnabled="{Binding Large}"/>
                            <TextBlock Text="МБ" VerticalAlignment="Center" Classes="caption"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Classes="primary" Command="{Binding ScanCommand}" IsEnabled="{Binding !Busy}"
                            ToolTip.Tip="Сначала только найти мусор, ничего не удаляя">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconSearch}" Foreground="White"/>
                            <TextBlock Text="{x:Static loc:Strings.CleanupScan}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="danger" Command="{Binding CancelScanCommand}" IsVisible="{Binding IsScanning}"
                            ToolTip.Tip="Остановить поиск мусора">
                        <TextBlock Text="{x:Static loc:Strings.Cancel}"/>
                    </Button>
                    <ProgressBar IsIndeterminate="True" Width="120" VerticalAlignment="Center" IsVisible="{Binding IsScanning}"/>
                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Classes="muted"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Classes="card" Padding="6">
            <Grid RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="8,6">
                    <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Classes="ghost" Command="{Binding SelectAllCommand}" ToolTip.Tip="Отметить все найденные элементы"><TextBlock Text="{x:Static loc:Strings.FmSelectAll}" FontSize="12"/></Button>
                    <Button Classes="ghost" Command="{Binding ClearSelectionCommand}" ToolTip.Tip="Снять все отметки"><TextBlock Text="{x:Static loc:Strings.FmClear}" FontSize="12"/></Button>
                    <Button Classes="danger" Command="{Binding DeleteSelectedCommand}"
                            ToolTip.Tip="Переместить отмеченное в корзину после подтверждения">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconTrash}" Foreground="White" Width="15" Height="15"/>
                            <TextBlock Text="{x:Static loc:Strings.CleanupDeleteSelected}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="28,140,*,110" Margin="8,3" Height="28">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <PathIcon Data="{Binding Icon}" Width="15" Height="15" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Text="{Binding KindText}" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Path}" Classes="caption" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" Classes="caption" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- #16: подтверждение удаления (как в Результатах) -->
        <Border Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding ShowDeleteConfirm}" Background="#80000000">
            <Border Classes="card" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Classes="h2" Text="{x:Static loc:Strings.ConfirmDeleteTitle}"/>
                    <TextBlock Text="{Binding DeleteConfirmText}" TextWrapping="Wrap" Classes="muted"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <Button Command="{Binding CancelDeleteCommand}">
                            <TextBlock Text="{x:Static loc:Strings.Cancel}"/>
                        </Button>
                        <Button Classes="danger" Command="{Binding ConfirmDeleteCommand}">
                            <TextBlock Text="{x:Static loc:Strings.Delete}"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
