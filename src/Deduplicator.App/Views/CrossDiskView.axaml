<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Deduplicator.App.Localization"
             x:Class="Deduplicator.App.Views.CrossDiskView">

    <Grid RowDefinitions="Auto,*" Margin="28,24">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Classes="h1" Text="{x:Static loc:Strings.CrossDiskTitle}"/>
                <TextBlock Classes="muted" Text="{x:Static loc:Strings.CrossDiskSubtitle}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="{Binding Summary}" Classes="muted" VerticalAlignment="Center"/>
                <ProgressBar IsIndeterminate="True" Width="110" IsVisible="{Binding IsBusy}" VerticalAlignment="Center"/>
                <Button Classes="primary" Command="{Binding OpenScanCommand}"
                        ToolTip.Tip="Перейти к поиску дублей и просканировать несколько дисков">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconSearch}" Foreground="White"/>
                        <TextBlock Text="Просканировать диски" Foreground="White"/>
                    </StackPanel>
                </Button>
                <Button Classes="ghost" Command="{Binding LoadCommand}" ToolTip.Tip="Обновить список совпадений между дисками">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconRefresh}"/>
                        <TextBlock Text="{x:Static loc:Strings.Refresh}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Classes="card" Padding="6">
            <Panel>
                <!-- Ночь-4: пустое состояние — иконка + текст из VM + подсказка -->
                <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsVisible="{Binding Empty, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <PathIcon Data="{StaticResource IconDatabase}" Width="48" Height="48"
                              Foreground="{DynamicResource TextTertiary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Empty}" FontSize="15" FontWeight="Medium"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="420"/>
                    <TextBlock Classes="muted" Text="Проверьте несколько дисков — совпадения файлов между ними появятся здесь, даже если диски уже отключены."
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="400"/>
                </StackPanel>
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="8,5" Padding="14" CornerRadius="10" Background="{DynamicResource SurfaceAlt}">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <PathIcon Grid.Column="0" Data="{StaticResource IconDatabase}" Width="18" Height="18"
                                                      Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" Margin="10,0"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Summary}" Classes="caption" VerticalAlignment="Center"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Files}" Margin="28,0,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="200,*,90" Margin="0,2">
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                                            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                                                     Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding VolumeConnected}"/>
                                                            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                                                     Fill="{DynamicResource TextTertiary}" IsVisible="{Binding !VolumeConnected}"/>
                                                            <TextBlock Text="{Binding VolumeName}" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding RelPath}" Classes="caption mono"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" Classes="caption" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Panel>
        </Border>
    </Grid>
</UserControl>
